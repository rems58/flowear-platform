# Flowear : variables d'environnement. Serveur uniquement sauf préfixe NEXT_PUBLIC_.
# Copier en .env.local (ignoré par git). Validé au démarrage par src/lib/env.ts.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3030

# Clerk (auth). Seule la clé publishable est publique.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=    # webhook « user.* » → /api/webhooks/clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
ADMIN_CLERK_USER_IDS=
# Testeurs : voient les IA privées, mais avec le parcours normal (semaine d'accueil puis mur)
# Ajouter quelqu'un : npm run tester:add son@email.test
TESTER_CLERK_USER_IDS=            # ids Clerk séparés par des virgules

# Supabase : projet dédié à Flowear, accès serveur uniquement (RLS activée)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA (au moins une clé ; ordre de repli OpenRouter → Groq → OpenAI → Mistral → Gemini)
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Repli payant recommandé (gpt-5-nano / gpt-5-mini), facturation à l'usage sans liste d'attente
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Rate limit (obligatoire en production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (phase 5)
RESEND_API_KEY=
EMAIL_FROM=
# Digest hebdo : secret des routes cron (Vercel l'envoie en Authorization: Bearer), 32 caractères aléatoires
CRON_SECRET=

# Stripe (phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Créés par `npm run stripe:setup` (il les affiche, tu les colles ici).
# Les prix par IA n'y sont pas : ils se créent tout seuls depuis le manifeste de l'IA.
STRIPE_PRICE_BUNDLE_MONTHLY=
STRIPE_PRICE_BUNDLE_YEARLY=

# Recherche web (Tavily, tool `search_web`, plans avec webSearch à vrai). Absente : pas de recherche.
TAVILY_API_KEY=

# Notifications push. `npm run push:keys` les génère, une fois pour toutes : la clé publique
# est enregistrée dans chaque navigateur abonné, la changer couperait tous les abonnements.
# Les mêmes clés en local et en production. Absentes = pas de notifications, rien ne casse.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@flowear.app

# Anti-bot sur l'outil public sans compte (phase 5)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Télémétrie Clerk (dev)
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
